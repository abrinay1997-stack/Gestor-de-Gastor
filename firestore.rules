rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isResourceOwner() {
      return isAuthenticated() && resource.data.userId == request.auth.uid;
    }
    
    function isRequestOwner() {
      return isAuthenticated() && request.resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }
    
    match /accounts/{accountId} {
      allow read, delete: if isResourceOwner();
      allow create: if isRequestOwner();
      allow update: if isResourceOwner() && isRequestOwner();
    }
    
    match /categories/{categoryId} {
      allow read, delete: if isResourceOwner();
      allow create: if isRequestOwner();
      allow update: if isResourceOwner() && isRequestOwner();
    }
    
    match /transactions/{transactionId} {
      allow read, delete: if isResourceOwner();
      allow create: if isRequestOwner();
      allow update: if isResourceOwner() && isRequestOwner();
    }
    
    match /budgets/{budgetId} {
      allow read, delete: if isResourceOwner();
      allow create: if isRequestOwner();
      allow update: if isResourceOwner() && isRequestOwner();
    }

    match /jars/{jarId} {
      allow read, delete: if isResourceOwner();
      allow create: if isRequestOwner();
      allow update: if isResourceOwner() && isRequestOwner();
    }
  }
}
